# Local configuration and credentials
configs/*.local.json
.env
.env.*

# Python environments and bytecode
.venv/
__pycache__/
*.pyc

# Disposable offline experiments; dev/formal results remain deliverable
/results/mock/

# Local report dependencies, render QA and duplicate delivery archives
/results/reports/_dependencies/
/results/reports/_qa/
/results/reports/v03_development_evaluation/_qa/
/results/prompt_comparison/**/.lock
/results/reports/Group13_Report_Package.zip
/results/upload_audit/
~$*.docx

# Regenerable duplicates; the 16 main report SVG figures remain versioned
/results/reports/figures/*.png
/results/reports/figures/confusion_*.svg
/results/reports/data/completed_attempts.csv
/results/reports/data/scored_predictions.csv
/results/analysis/group13-dev-acceptance-20261111-verified/*.png
/results/analysis/group13-dev-acceptance-20261111-verified/*.svg
